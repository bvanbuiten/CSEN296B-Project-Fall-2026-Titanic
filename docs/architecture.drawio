es, deposits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2a41;fontSize=10.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="764" y="634" width="86" height="82" as="geometry"/></mxCell><mxCell id="res-refund" value="Result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2a41;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="866" y="570" width="72" height="44" as="geometry"/></mxCell><mxCell id="ag-refund" value="&lt;b&gt;Refund Request&lt;/b&gt;&lt;br&gt;Mgmt Agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2a41;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="956" y="566" width="162" height="52" as="geometry"/></mxCell><mxCell id="llm-refund" value="&lt;b&gt;LLM&lt;/b&gt;&lt;br&gt;Claude&lt;br&gt;Haiku 5.5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2a41;fontSize=10.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="956" y="640" width="74" height="70" as="geometry"/></mxCell><mxCell id="tool-refund" value="&lt;b&gt;Tools: policy&lt;/b&gt;&lt;br&gt;RAG, issue /&lt;br&gt;deny refund,&lt;br&gt;escalate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2a41;fontSize=10.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1036" y="634" width="86" height="82" as="geometry"/></mxCell><mxCell id="res-reporting" value="Result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2a41;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1138" y="570" width="72" height="44" as="geometry"/></mxCell><mxCell id="ag-reporting" value="&lt;b&gt;Refund Reporting&lt;/b&gt;&lt;br&gt;Agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2a41;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1228" y="566" width="162" height="52" as="geometry"/></mxCell><mxCell id="llm-reporting" value="&lt;b&gt;LLM&lt;/b&gt;&lt;br&gt;Claude&lt;br&gt;Haiku 5.5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2a41;fontSize=10.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1228" y="640" width="74" height="70" as="geometry"/></mxCell><mxCell id="tool-reporting" value="&lt;b&gt;Tools: decision&lt;/b&gt;&lt;br&gt;reports, weekly&lt;br&gt;budget, list&lt;br&gt;decisions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b2a41;fontSize=10.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1308" y="634" width="86" height="82" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Authorization / Policy Gate (code, not the model): checks every tool call. Allow, deny, or escalate.&lt;/b&gt;&lt;br&gt;R1 refund at most $100;  R2 at most $500 per rolling 7 days;  R3 only the case's customer;  R4 no permission changes;&lt;br&gt;R5 supervisor decisions stand;  R6 nothing after revocation;  R7 email only the address on file or supervisor@titanic.test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf1d3;strokeColor=#9a6b00;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1360" height="58" as="geometry"/></mxCell><mxCell id="mail" value="&lt;b&gt;Mock Email Service&lt;/b&gt;&lt;br&gt;inbox and sent mail (no real email)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f4;strokeColor=#1b2a41;fontSize=11.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="876" width="230" height="54" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b&gt;Mock Payment Service&lt;/b&gt;&lt;br&gt;issues refunds and deposits by&lt;br&gt;updating the account balance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f4;strokeColor=#1b2a41;fontSize=11.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="876" width="250" height="54" as="geometry"/></mxCell><mxCell id="sup" value="&lt;b&gt;Human Supervisor&lt;/b&gt;&lt;br&gt;(supervisor portal)&lt;br&gt;approves or denies escalations,&lt;br&gt;revokes or restores the agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2ea;strokeColor=#2e7d5b;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="870" width="250" height="70" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b&gt;Governance layer: append-only, hash-chained audit log. Request, plan, every model call, every tool attempt, every gate decision&lt;/b&gt;&lt;br&gt;(allow / deny / escalate + rule), refunds, emails, supervisor decisions, revocations, policy uploads, red-team results." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8e3e6;strokeColor=#b23a48;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="982" width="1360" height="56" as="geometry"/></mxCell><mxCell id="c63" value="sub-tasks over MCP (signed context)" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1f3a68;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1048" y="482" width="212" height="18" as="geometry"/></mxCell><mxCell id="c64" value="results back over MCP" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#2e7d5b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="915" y="524" width="129" height="18" as="geometry"/></mxCell><mxCell id="c65" value="tool call down, allow / deny + result up" style="text;html=1;align=center;verticalAlign=top;fontSize=10.5;fontColor=#9a6b00;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="822" y="750" width="241" height="18" as="geometry"/></mxCell><mxCell id="c66" value="escalations" style="text;html=1;align=right;verticalAlign=top;fontSize=10;fontColor=#9a6b00;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1096" y="842" width="68" height="17" as="geometry"/></mxCell><mxCell id="c67" value="approve / deny / revoke" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#2e7d5b;fontFamily=Helvetica;" vertex="1" parent="1"><